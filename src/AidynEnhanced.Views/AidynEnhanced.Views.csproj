<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AidynEnhanced.Views</RootNamespace>
    <!--
      Godot's SDK, for its source generators: without them a node's _Ready and _Process are never called. The library
      isn't a Godot project, so no script path is generated: Godot gives its nodes scripts of their own as code makes
      them (ADR 0022).
    -->
    <GodotDisabledSourceGenerators>ScriptPathAttribute</GodotDisabledSourceGenerators>
  </PropertyGroup>

  <ItemGroup>
    <!-- What the runtime and the editor both draw with (ADR 0022). It reads plugins and the core, never the ROM. -->
    <ProjectReference Include="..\AidynEnhanced.Core\AidynEnhanced.Core.csproj" />
    <ProjectReference Include="..\AidynEnhanced.Plugins\AidynEnhanced.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The text's typeface (TextFace), Marcellus SC under the SIL Open Font License (assets/fonts/OFL.txt), carried in the assembly. -->
    <EmbeddedResource Include="..\..\assets\fonts\MarcellusSC-Regular.ttf" LogicalName="MarcellusSC-Regular.ttf" />
    <!-- The pause menu's blank parchment (UiImages.OnParchment), the user's own art (assets/ui/README.md). -->
    <EmbeddedResource Include="..\..\assets\ui\parchment.png" LogicalName="parchment.png" />
    <!-- The Party tab's tabs, their icons, the gold's purse, the silhouette's figures and the potions (UiImages.Art), the user's own art. -->
    <EmbeddedResource Include="..\..\assets\ui\ui-*.png;..\..\assets\ui\silhouette-*.png;..\..\assets\ui\parchment-*.png;..\..\assets\ui\icon-*.png;..\..\assets\ui\potion-*.png" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
