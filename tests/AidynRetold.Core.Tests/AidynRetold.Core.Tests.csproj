  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AidynRetold.TestSupport\AidynRetold.TestSupport.csproj" />
    <ProjectReference Include="..\..\src\AidynRetold.Core\AidynRetold.Core.csproj" />
  </ItemGroup>

</Project>
