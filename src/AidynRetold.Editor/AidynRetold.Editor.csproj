<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <!-- Explicit, or the Godot editor writes its own default (net8.0) into this file. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AidynRetold.Editor</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- The editor reads plugins (ADR 0010). AidynRetold.Rom is only for running the importer and reading checkpoints, which needs no ROM. -->
    <ProjectReference Include="..\AidynRetold.Core\AidynRetold.Core.csproj" />
    <ProjectReference Include="..\AidynRetold.Plugins\AidynRetold.Plugins.csproj" />
    <ProjectReference Include="..\AidynRetold.Rom\AidynRetold.Rom.csproj" />
    <!-- The runtime's views, so the editor plays actors and draws map sets as the game does (ADRs 0010, 0022). -->
    <ProjectReference Include="..\AidynRetold.Views\AidynRetold.Views.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AidynRetold.Views" />
  </ItemGroup>

</Project>
